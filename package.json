{
  "name": "siyuan-homepage",
  "version": "4.10.1",
  "type": "module",
  "description": "Provides personalized homepage layout and rich functional modules.",
  "repository": "https://github.com/Glaube-TY/siyuan-homepage",
  "homepage": "https://github.com/Glaube-TY/siyuan-homepage",
  "packageManager": "pnpm@8.15.9",
  "author": "Glaube-TY",
  "license": "MIT",
  "scripts": {
    "dev": "run-p dev:app dev:kernel",
    "dev:app": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline VITE_BUILD_TARGET=app vite build --watch",
    "dev:kernel": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline VITE_BUILD_TARGET=kernel vite build --watch",
    "dev:debug": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline VITE_BUILD_TARGET=app vite build --watch",
    "dev:setup": "cross-env SIYUAN_SKIP_DEV_DEPLOY=1 pnpm build:dev && node --no-warnings ./scripts/make_dev_link.js",
    "build": "pnpm build:robot-electron && pnpm build:app && pnpm build:kernel && pnpm sync-dev",
    "build:dev": "pnpm build:robot-electron && cross-env NODE_ENV=development VITE_BUILD_TARGET=app vite build && cross-env NODE_ENV=development VITE_BUILD_TARGET=kernel vite build",
    "build:app": "pnpm typecheck && cross-env NODE_ENV=production VITE_BUILD_TARGET=app vite build",
    "build:kernel": "cross-env NODE_ENV=production VITE_BUILD_TARGET=kernel vite build",
    "build:robot-electron": "node --no-warnings ./scripts/build-robot-electron-providers.js",
    "sync-dev": "node --no-warnings ./scripts/sync_dist_to_dev.js",
    "make-link": "pnpm dev:setup",
    "make-link-win": "pnpm dev:setup",
    "update-version": "node --no-warnings ./scripts/update_version.js",
    "release": "node --no-warnings ./scripts/release.js",
    "make-install": "pnpm build && node --no-warnings ./scripts/make_install.js",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify:homepage-theme": "node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-homepage-theme-framework.ts",
    "verify:homepage-settings": "node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-homepage-settings-experience.ts",
    "verify:widget-presentation": "node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-widget-presentation-framework.ts",
    "verify:performance": "node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-global-performance.ts",
    "verify:mouse-trail": "node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-mouse-trail-framework.ts",
    "verify:falling-effect": "node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-falling-effect-framework.ts",
    "verify:agent-platform": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-agent-platform-profile.ts",
    "verify:robot-core-extremes": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-robot-core-extremes.ts",
    "verify:homepage-manage-comprehensive": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-homepage-manage-comprehensive.ts",
    "verify:agent-runtime": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-agent-runtime-protocol.ts",
    "verify:database-row-merge": "cross-env TS_NODE_FILES=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-database-row-merge.ts",
    "verify:siyuan-asset-content": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-siyuan-asset-content.ts",
    "verify:siyuan-asset-annotation": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-siyuan-asset-annotation.ts",
    "verify:siyuan-asset-rename": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-siyuan-asset-rename.ts",
    "verify:siyuan-riff": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-siyuan-riff.ts",
    "verify:siyuan-bookmark-list-blocks": "cross-env TS_NODE_FILES=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-siyuan-bookmark-list-blocks.ts",
    "verify:agent-continuation": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-agent-continuation-guard.ts",
    "verify:agent-context": "node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-agent-context-compaction-v4.ts",
    "verify:agent-context-preflight": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-agent-context-preflight-v4.ts",
    "verify:agent-deferred-toolset": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-agent-deferred-toolset-v4.ts",
    "verify:global-web-search": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-global-web-search.ts",
    "verify:kb-settings-persistence": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-kb-settings-persistence.ts",
    "verify:kb-stream-performance": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-kb-stream-presentation-performance.ts",
    "verify:agent-tool-discovery": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-agent-tool-discovery-recovery.ts",
    "verify:quick-note-write": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-quick-note-write.ts",
    "verify:provider-stream-watchdog": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-provider-stream-watchdog.ts",
    "verify:agent-context-legacy": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-agent-context-legacy-archive-v4.ts",
    "verify:agent-ui": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-agent-execution-ui.ts",
    "verify:automation-storage": "node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-automation-job-storage.ts",
    "verify:automation-scheduler": "node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-automation-scheduler.ts",
    "verify:automation-permissions": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-automation-unattended-permissions.ts",
    "verify:global-calendar": "node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-global-calendar.ts",
    "verify:task-index-live-sync": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-task-index-live-sync.ts",
    "verify:enhanced-diary-task-migration": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --loader ./scripts/ts-node-alias-loader.mjs --experimental-specifier-resolution=node scripts/verify-enhanced-diary-task-migration.ts",
    "verify:habit-tracker": "node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-habit-tracker.ts",
    "verify:visual-chart": "node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-visual-chart.ts",
    "verify:mobile-homepage": "node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-mobile-homepage.ts",
    "verify:mobile-dialogs": "node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-mobile-dialog-framework.ts",
    "verify:entitlement": "node --loader ts-node/esm --experimental-specifier-resolution=node scripts/verify-homepage-entitlement.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/elliptic": "^6.4.18",
    "@types/node": "^25.5.2",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "cross-env": "^10.1.0",
    "esbuild": "0.25.12",
    "eslint": "^9.17.0",
    "fast-glob": "^3.2.12",
    "glob": "^13.0.6",
    "globals": "^15.13.0",
    "js-yaml": "^4.1.0",
    "minimist": "^1.2.8",
    "npm-run-all": "^4.1.5",
    "rollup-plugin-livereload": "^2.0.5",
    "sass-embedded": "^1.89.2",
    "siyuan": "1.2.2",
    "svelte": "^5.55.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^4.0.1",
    "vite-plugin-zip-pack": "^1.0.5"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@floating-ui/dom": "^1.7.4",
    "@larksuiteoapi/node-sdk": "^1.68.0",
    "@lucide/svelte": "^1.21.0",
    "@tencent-connect/qqbot-nodejs": "^1.0.4",
    "ai": "^6.0.158",
    "ajv": "^8.20.0",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.2.6",
    "echarts": "^5.6.0",
    "echarts-wordcloud": "^2.1.0",
    "elliptic": "^6.6.1",
    "howler": "^2.2.4",
    "jszip": "^3.10.1",
    "mousetrap": "^1.6.5",
    "music-metadata": "^11.13.0",
    "qrcode": "^1.5.4",
    "quill": "^2.0.2",
    "siyuan-kit-svelte": "^0.1.3",
    "sortablejs": "^1.15.6",
    "svelte-multiselect": "^11.6.4",
    "swiper": "^12.0.3",
    "tyme4ts": "^1.3.9",
    "uapi-sdk-typescript": "0.1.4",
    "zod": "^4.4.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "siyuan@1.2.2": "patches/siyuan@1.2.2.patch"
    }
  }
}
